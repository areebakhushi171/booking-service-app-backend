generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  provider
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  BOOKING
  MESSAGE
}

model User {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  phone                String
  passwordHash         String
  role                 UserRole @default(customer)
  avatarUrl            String?
  avatarPublicId       String?
  businessName         String?
  businessCategory     String?
  notificationsEnabled Boolean  @default(true)
  darkMode             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // One User can provide multiple Services
  services Service[]

  customerBookings      Booking[]      @relation("BookingCustomer")
  favorites             Favorite[]
  customerConversations Conversation[] @relation("ConversationCustomer")
  ownedConversations    Conversation[] @relation("ConversationOwner")
  sentMessages          Message[]      @relation("MessageSender")
  notifications         Notification[]
}

model Service {
  id               String   @id @default(cuid())
  name             String
  description      String
  category         String
  price            Decimal  @db.Decimal(10, 2)
  duration         Int
  imageUrl         String?
  imagePublicId    String?
  gallery          String[]
  galleryPublicIds String[] @default([])
  features         String[]
  isActive         Boolean  @default(true)
  providerId       String
  country          String?
  city             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Each Service belongs to one User
  provider User @relation(fields: [providerId], references: [id])

  bookings      Booking[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([country, city])
}

model Booking {
  id           String        @id @default(cuid())
  serviceId    String
  customerId   String
  servicePrice Decimal?      @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  service  Service @relation(fields: [serviceId], references: [id])
  customer User    @relation("BookingCustomer", fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([serviceId, status, startDate, endDate])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([userId, serviceId])
  @@index([serviceId])
}

model Conversation {
  id         String   @id @default(cuid())
  customerId String
  ownerId    String
  serviceId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User      @relation("ConversationCustomer", fields: [customerId], references: [id])
  owner    User      @relation("ConversationOwner", fields: [ownerId], references: [id])
  service  Service   @relation(fields: [serviceId], references: [id])
  messages Message[]

  @@unique([customerId, ownerId, serviceId])
  @@index([customerId, updatedAt])
  @@index([ownerId, updatedAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  data      Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}
