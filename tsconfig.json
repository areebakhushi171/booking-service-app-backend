{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./generated-js",
    "rootDir": "./generated/prisma",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["generated/prisma/**/*.ts"],
  "exclude": ["node_modules"]
}